@inherits AuthenticationModelComponent

@* The consumer wraps this panel in
   <AuthorizeView><NotAuthorized>...</NotAuthorized></AuthorizeView>; the panel
   pushes session state through PrfAuthenticationStateProvider so the
   AuthorizeView flips to Authorized on success.

   Two shapes, chosen by the disk:

   - Encrypted VFS → Sign in, alone. The pool opens with the credential its
     manifest names and no other, so a newly registered passkey would derive
     a key that cannot unlock it.
   - Plain VFS → Sign in and Register, both on screen at once.

   Either way one click runs one ceremony, and an abandoned prompt leaves the
   shape it started from standing — the warning goes to the status bar, not
   into a different screen. *@
@* Nothing at all until the manifest has been read. The consumer renders this
   in the NotAuthorized branch of <AuthorizeView Policy="DatabaseOpen">, which
   is also what the tree shows before initialization has reported anything — so
   on a cold start this panel is on screen before it knows which of its two
   shapes to take, or whether a plain pool is about to open and make it moot.
   Rendering the chrome meanwhile flashes a credential prompt at someone who
   never needed one. *@
@if (Model.PoolEncrypted is not null)
{
<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex flex-column align-center justify-center" Style="min-height: 60vh;">
    <MudIcon Icon="@Icons.Material.Filled.Security"
             Color="Color.Primary"
             Style="font-size: 6rem;"
             Class="mb-4" />

    <MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true">
        @Model.Localizer["Header_Title"]
    </MudText>

    <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-6 mud-text-secondary">
        @Model.Localizer["Header_Subtitle"]
    </MudText>

    @if (!string.IsNullOrEmpty(Model.WrongPasskeyPublicKey))
    {
        @* Wrong-passkey-for-disk: the just-derived pubkey is shown so the
           user can copy it for "export disk for recipient" testing. The
           session itself is rejected — the user is NOT signed in. *@
        <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4 mud-width-full">
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-3">
                @Model.Localizer["Alert_WrongPasskeyForPool"]
            </MudAlert>
            <PublicKeyDisplay PublicKey="@Model.WrongPasskeyPublicKey" CredentialId="@Model.WrongPasskeyCredentialId" />
            <MudStack Row="true" Spacing="2" Class="mt-3">
                <MudButton OnClick="@Model.DismissWrongPasskey"
                           Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Close">
                    @Model.Localizer["Btn_DismissWrongPasskey"]
                </MudButton>
            </MudStack>
        </MudPaper>
    }

    @if (Model.IsPrfSupported is null)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            <MudText>@Model.Localizer["Status_CheckingPrf"]</MudText>
        </MudStack>
    }
    else if (Model.IsPrfSupported == false)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Outlined">
            @Model.Localizer["Alert_PrfNotSupported"]
        </MudAlert>
    }
    else if (Model.PoolEncrypted == true)
    {
        @* Encrypted VFS — sign-in only, targeted at the bound credential.
           Recovery for a passkey that is gone lives elsewhere: the host's
           full reset, or an .eds envelope import on the encryption page. *@
        <MudButtonAsyncRx Command="@Model.SignIn"
                          Variant="Variant.Filled"
                          Color="Color.Primary"
                          Size="Size.Large"
                          StartIcon="@Icons.Material.Filled.Fingerprint">
            @Model.Localizer["Btn_SignIn"]
        </MudButtonAsyncRx>
        <MudText Typo="Typo.caption" Class="mt-2 mud-text-secondary">
            @Model.Localizer["Caption_EncryptedPool"]
        </MudText>
    }
    else
    {
        @* Plain VFS — both routes in, side by side and always present. *@
        <MudButtonAsyncRx Command="@Model.SignIn"
                          Variant="Variant.Filled"
                          Color="Color.Primary"
                          Size="Size.Large"
                          StartIcon="@Icons.Material.Filled.Fingerprint">
            @Model.Localizer["Btn_SignIn"]
        </MudButtonAsyncRx>
        <MudText Typo="Typo.caption" Class="mt-2 mud-text-secondary">
            @Model.Localizer["Caption_DiscoverablePicker"]
        </MudText>

        <MudDivider Class="my-6 mud-width-full" />

        <MudPaper Elevation="0" Outlined="true" Class="pa-4 mud-width-full">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1">@Model.Localizer["Register_Header"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @Model.Localizer["Register_Description"]
                </MudText>
                <MudTextField @bind-Value="@Model.RegisterDisplayName"
                              Label="@(Model.Localizer["Field_DisplayNameLabel"])"
                              Variant="Variant.Outlined"
                              HelperText="@(Model.Localizer["Field_DisplayNameHelper"])"
                              Disabled="@Model.Register.Executing" />
                <MudButtonAsyncRx Command="@Model.Register"
                                  Variant="Variant.Outlined"
                                  Color="Color.Primary"
                                  Size="Size.Large"
                                  StartIcon="@Icons.Material.Filled.PersonAdd"
                                  FullWidth="true">
                    @Model.Localizer["Btn_Register"]
                </MudButtonAsyncRx>
            </MudStack>
        </MudPaper>
    }
</MudContainer>
}
